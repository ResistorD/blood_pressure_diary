# Runtime profile: dev | stage | live
APP_ENV=dev

# Core runtime
PS_MODE=DRY_RUN
EXECUTION_MODE=paper
PS_DB_PATH=polysyndicate.db

# API
PS_API_HOST=127.0.0.1
PS_API_PORT=8000

# Security (required in stage/live for admin-protected controls)
ADMIN_TOKEN=

# Execution controls
PS_ENABLE_EXECUTION=0
LIVE_DRY_RUN=1
LIVE_MAX_NOTIONAL=0
LIVE_MAX_ORDERS_PER_DAY=0
PAPER_FIXED_NOTIONAL=10.0
PS_MM_MIN_EV=-0.001
PS_MM_MAX_SPREAD=0.5
PS_MM_PROBE_ALLOW_UNTRADEABLE=false
PS_MM_FINAL_PROBE=false

# Live-only credentials (required for EXECUTION_MODE=live_stage0)
POLYMARKET_API_URL=
POLYMARKET_KEY=
PRIVATE_KEY=
